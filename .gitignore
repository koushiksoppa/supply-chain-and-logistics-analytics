# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.ipynb_checkpoints/
.pytest_cache/

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- Jupyter ---
.ipynb_checkpoints

# --- OS files ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/

# --- Data (large synthetic dataset should not bloat the repo) ---
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Database files ---
*.db
*.sqlite
*.sqlite3
sql/supply_chain.db

# --- Power BI (large binary; track via Git LFS or release assets instead) ---
powerbi/*.pbix

# --- Logs ---
*.log

# --- Environment variables / secrets ---
.env
